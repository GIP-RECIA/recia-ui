{
  "name": "@gip-recia/ui",
  "version": "1.1.0",
  "contributors": [
    {
      "name": "Quentin Guillemin",
      "email": "quentin.guillemin@recia.fr",
      "url": "https://github.com/Quentin-Guillemin"
    }
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/GIP-RECIA/recia-ui/tree/main/packages/ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GIP-RECIA/recia-ui.git"
  },
  "bugs": {
    "url": "https://github.com/GIP-RECIA/recia-ui/issues"
  },
  "keywords": [
    "gip-recia"
  ],
  "exports": {
    ".": "./scss/index.scss",
    "./*": "./scss/*",
    "./components": "./scss/components/index.scss",
    "./components/*": "./scss/components/*",
    "./core": "./scss/core/index.scss",
    "./core/*": "./scss/core/*",
    "./functions": "./scss/functions/index.scss",
    "./functions/*": "./scss/functions/*",
    "./layouts": "./scss/layouts/index.scss",
    "./layouts/*": "./scss/layouts/*",
    "./mixins": "./scss/mixins/index.scss",
    "./mixins/*": "./scss/mixins/*"
  },
  "files": [
    "scss/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "sass -s compressed --error-css --update --no-source-map scss/index.scss dist/recia-style.css",
    "release": "yarn run -T commit-and-tag-version -t 'ui/v' --path . --release-as $1 || echo 'Please specify a version type (yarn run release -- [patch, minor, major])'"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "eslint": "^10.9.1",
    "eslint-plugin-format": "^2.0.1",
    "ress": "^6.0.0",
    "sass": "^1.103.1"
  }
}
